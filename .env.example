# Dashboard login token (required). Pick a long random string.
DASHBOARD_TOKEN=change-me
# Timezone used for display/scheduling defaults
TZ_NAME=Asia/Kolkata
# "mock" logs instead of posting. Use "live" once real tokens are set.
PUBLISH_MODE=mock
# Claude drafting (optional: falls back to a simple template without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# LinkedIn (personal profile)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
LINKEDIN_API_VERSION=202510
# Instagram (phase 2)
IG_USER_ID=
IG_ACCESS_TOKEN=
DB_PATH=data/scheduler.db
